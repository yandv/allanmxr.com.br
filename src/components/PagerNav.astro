---
interface Link {
  href: string;
  label: string;
  title: string;
  meta: string;
}

interface Props {
  ariaLabel: string;
  previous: Link;
  next: Link & { summary: string; footer: string };
}

const { ariaLabel, previous, next } = Astro.props;
---

<nav aria-label={ariaLabel} class="mt-20 grid grid-cols-[minmax(0,1fr)] gap-4 wrap-break-word md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
  <a href={previous.href} class="group order-2 flex flex-col justify-between gap-6 rounded-[1.75rem] border border-line p-6 hover:bg-surface md:order-1 sm:p-7">
    <span class="flex items-center gap-2 text-ink-soft">
      <svg viewBox="0 0 24 24" class="size-4 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M15 5l-7 7 7 7" />
      </svg>
      {previous.label}
    </span>
    <span>
      <span class="block font-display text-2xl font-bold tracking-[-0.02em]">{previous.title}</span>
      <span class="mt-1 block text-sm text-ink-soft">{previous.meta}</span>
    </span>
  </a>

  <a
    href={next.href}
    class="on-panel-focus group order-1 flex flex-col gap-5 rounded-[1.75rem] border border-panel-line bg-panel p-7 text-on-panel md:order-2 sm:p-9"
  >
    <span class="flex flex-wrap items-center justify-between gap-3">
      <span class="text-on-panel-soft">{next.label}</span>
      <span class="font-pixel text-sm text-xp">{next.meta}</span>
    </span>
    <span class="font-display text-[clamp(2rem,5vw,2.75rem)] leading-none font-extrabold tracking-[-0.03em] group-hover:text-xp">{next.title}</span>
    <span class="line-clamp-3 max-w-xl text-on-panel-soft">{next.summary}</span>
    <span class="mt-auto flex items-center justify-between gap-4 border-t border-on-panel/15 pt-5 font-semibold">
      <span>{next.footer}</span>
      <span class="grid size-11 shrink-0 place-items-center rounded-full bg-xp text-on-xp transition-transform group-hover:translate-x-1">
        <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </span>
    </span>
  </a>
</nav>
