---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PixelPortrait from '../PixelPortrait.astro';
import ExternalLink from '../ExternalLink.astro';
import {
  featuredStoryIds,
  job,
  journey,
  languages,
  profile,
  scrapers,
  sideProjects,
  sideProjectsNote,
  skills,
} from '../../data/profile';
import { collectionsOf } from '../../i18n/content';
import { locales, localize, projectPath, ui, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const text = localize(locale);
const role = text(profile.role);
const resumeLocales = [locale, ...locales.filter((code) => code !== locale)];
const place = t.location(profile.city, profile.region);
const scraperGroups = [...Map.groupBy(scrapers, (scraper) => scraper.group)];
const yieldCase = await getEntry(collectionsOf[locale].cases, 'yield');
const education = (await getCollection('education')).toSorted((a, b) => a.data.order - b.data.order);

const featuredStories = await Promise.all(
  (await Promise.all(featuredStoryIds.map((id) => getEntry(collectionsOf[locale].stories, id))))
    .filter((story) => story !== undefined)
    .map(async (story) => ({ story, project: await getEntry(story.data.project) })),
);

const title = `${profile.shortName} · ${role}`;
const pageUrl = new URL('/', Astro.site).href;
const profileJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': pageUrl,
  url: pageUrl,
  name: title,
  description: t.homeDescription,
  inLanguage: t.htmlLang,
  isPartOf: { '@type': 'WebSite', '@id': new URL('/#website', Astro.site).href, name: profile.name, url: new URL('/', Astro.site).href },
  mainEntity: {
    '@type': 'Person',
    '@id': new URL('/#person', Astro.site).href,
    name: profile.name,
    alternateName: ['allanmxr', profile.shortName],
    url: new URL('/', Astro.site).href,
    image: new URL('/og.png', Astro.site).href,
    jobTitle: role,
    description: t.homeDescription,
    email: `mailto:${profile.email}`,
    address: { '@type': 'PostalAddress', addressLocality: profile.city, addressRegion: profile.region, addressCountry: 'BR' },
    alumniOf: education.map((course) => ({ '@type': 'CollegeOrUniversity', name: course.data.institution })),
    worksFor: { '@type': 'Organization', name: job.company },
    knowsAbout: skills.flatMap((skill) => skill.items.map(text)),
    knowsLanguage: languages.map((language) => text(language.name)),
    sameAs: Object.values(profile.links),
  },
};
---

<Layout
  locale={locale}
  title={title}
  description={t.homeDescription}
  jsonLd={profileJsonLd}
>
  <section class="mx-auto grid max-w-6xl items-center gap-12 px-4 pt-8 pb-20 sm:px-6 md:grid-cols-[1.2fr_1fr] md:gap-14 md:pt-16 md:pb-28">
    <div>
      <p class="text-lg text-ink-soft">
        {t.heroGreeting} <strong class="font-semibold text-ink">{role}</strong> {t.heroPlace(place)}
      </p>
      <h1 class="mt-4 text-[clamp(3rem,7.6vw,5.25rem)] leading-[0.98] font-extrabold tracking-[-0.035em]">{t.heroTitle}</h1>
      <p class="mt-7 max-w-[34rem] text-lg text-ink-soft">{t.heroSummary}</p>
      <ul class="mt-6 flex max-w-[34rem] flex-wrap gap-2" aria-label={t.focusLabel}>
        {t.heroFocus.map((focus) => (
          <li class="rounded-md border border-line bg-surface px-2.5 py-1 text-sm font-semibold">{focus}</li>
        ))}
      </ul>
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <details id="resume-menu" class="group relative">
          <summary class="flex cursor-pointer list-none items-center gap-2 rounded-xl bg-cta px-6 py-3 font-semibold text-on-cta hover:opacity-90 [&::-webkit-details-marker]:hidden">
            {t.downloadResume}
            <svg viewBox="0 0 24 24" class="size-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m6 9 6 6 6-6" />
            </svg>
          </summary>
          <ul class="absolute top-full left-0 z-20 mt-2 min-w-full rounded-xl border border-line bg-surface p-1.5 shadow-lg shadow-black/10">
            {resumeLocales.map((code) => (
              <li>
                <a
                  href={ui[code].resumePdf}
                  download
                  hreflang={ui[code].htmlLang}
                  lang={ui[code].htmlLang}
                  class="block rounded-lg px-4 py-2.5 font-semibold whitespace-nowrap hover:bg-paper"
                >
                  {ui[code].resumePdfOption}
                </a>
              </li>
            ))}
          </ul>
        </details>
        <a href={`mailto:${profile.email}`} class="rounded-xl border border-ink px-6 py-3 font-semibold hover:bg-surface">{t.talkToMe}</a>
        <a href="/resume" class="text-link sm:px-2">{t.viewResume}</a>
      </div>
      <p class="mt-8 flex max-w-[34rem] items-start gap-3 text-ink-soft">
        <span class="mt-[0.55rem] size-2 shrink-0 bg-accent" aria-hidden="true"></span>
        {t.heroInvite}
      </p>
    </div>
    <PixelPortrait locale={locale} />
  </section>

  <section id="now" class="border-t border-line">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-28">
      <h2 class="text-[clamp(2rem,4.6vw,3.25rem)]">{t.workTitle}</h2>

      <article class="mt-12 grid gap-5 border-t border-line pt-10 md:mt-16 md:grid-cols-[17rem_1fr] md:gap-12 md:pt-12">
        <div>
          <p class="inline-flex items-center gap-2 rounded-md bg-xp px-2.5 py-1 text-sm font-semibold text-on-xp">{t.currentJob}</p>
          <h3 class="mt-4 text-3xl">{job.company}</h3>
          <p class="mt-2 text-ink-soft">{text(job.products)}</p>
          <p class="mt-3 font-semibold text-accent">{text(job.period)}</p>
        </div>
        <div class="max-w-2xl">
          <p class="text-lg">{text(job.summary)}</p>
          <ul class="mt-6 grid gap-x-8 gap-y-2.5 sm:grid-cols-2">
            {job.highlights.map((highlight) => (
              <li class="flex gap-3 text-ink-soft">
                <span class="mt-[0.6rem] size-2 shrink-0 bg-accent" aria-hidden="true" />
                {text(highlight)}
              </li>
            ))}
          </ul>
          <p class="mt-6 text-sm text-ink-soft"><span class="sr-only">{t.technologies}</span>{job.stack.join(', ')}</p>
          <a href={projectPath(job.slug)} class="text-link mt-5 inline-block">{t.workLink(job.company)}</a>
        </div>
      </article>

      <div class="mt-16 border-t border-line pt-10 md:mt-20 md:pt-12">
        <div class="grid gap-4 md:grid-cols-[17rem_1fr] md:gap-12">
          <h3 class="text-3xl">{t.sideProjectsTitle}</h3>
          <p class="max-w-2xl text-lg text-ink-soft">{text(sideProjectsNote)}</p>
        </div>
        <ul class="mt-10 grid gap-4 md:grid-cols-2">
          {sideProjects.map((work) => (
            <li class="flex flex-col rounded-[1.75rem] border border-line p-6 sm:p-8">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <h4 class="font-display text-2xl font-bold">{work.company}</h4>
                <p class="font-semibold text-accent">{text(work.period)}</p>
              </div>
              <p class="mt-1 text-ink-soft">{text(work.products)}</p>
              <p class="mt-5">{text(work.summary)}</p>
              <p class="mt-5 text-sm text-ink-soft"><span class="sr-only">{t.technologies}</span>{work.stack.join(', ')}</p>
              <a href={projectPath(work.slug)} class="text-link mt-auto inline-block pt-5">{t.workLink(work.company)}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {featuredStories.length > 0 && (
    <section id="cases" class="border-t border-line">
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-28">
        <h2 class="text-[clamp(2rem,4.6vw,3.25rem)]">{t.featuredTitle}</h2>
        <p class="mt-4 max-w-xl text-lg text-ink-soft">{t.featuredLead}</p>
        <ul class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {featuredStories.map(({ story, project }) => (
            <li>
              <a href={projectPath(story.id)} class="group flex h-full flex-col rounded-[1.75rem] border border-line p-6 hover:bg-surface sm:p-7">
                <span class="font-semibold text-accent">{project.data.title}</span>
                <span class="mt-3 font-display text-xl leading-snug font-bold tracking-[-0.01em] decoration-accent decoration-2 underline-offset-4 group-hover:underline">
                  {story.data.title}
                </span>
                <span class="mt-3 line-clamp-4 text-ink-soft">{story.data.summary}</span>
                <span class="mt-auto flex items-center gap-2 pt-6 font-semibold">
                  {t.readCase}
                  <svg viewBox="0 0 24 24" class="size-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section id="projects" class="border-t border-line">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-28">
      <h2 class="text-[clamp(2rem,4.6vw,3.25rem)]">{t.projectsTitle}</h2>
      <p class="mt-4 max-w-xl text-lg text-ink-soft">{t.projectsLead}</p>

      <article class="mt-12 grid gap-10 rounded-[1.75rem] border border-panel-line bg-panel p-6 text-on-panel sm:p-10 md:grid-cols-[1.4fr_1fr] md:items-end md:p-12">
        <div>
          <p class="inline-flex items-center gap-2 rounded-md bg-xp px-2.5 py-1 text-sm font-semibold text-on-xp">
            <span class="size-2 bg-on-xp motion-safe:animate-pulse" aria-hidden="true" />
            {t.inProgress}
          </p>
          <h3 class="mt-6 text-[clamp(2.5rem,6vw,4.25rem)] font-extrabold tracking-[-0.035em]">Achalote</h3>
          <p class="mt-4 max-w-lg text-lg text-on-panel-soft">{t.achaloteSummary}</p>
        </div>
        <div>
          <dl class="border-b border-on-panel/20">
            {t.achaloteStats.map((stat) => (
              <div class="flex items-baseline justify-between gap-4 border-t border-on-panel/20 py-3">
                <dt class="text-on-panel-soft">{stat.label}</dt>
                <dd class="font-display text-xl font-bold">{stat.value}</dd>
              </div>
            ))}
          </dl>
          <ExternalLink
            locale={locale}
            href="https://achalote.com.br"
            class="on-panel-focus mt-6 block rounded-xl bg-xp px-5 py-3 text-center font-semibold text-on-xp hover:opacity-90"
          >
            {t.visitAchalote}
          </ExternalLink>
          <a href={projectPath('achalote')} class="on-panel-focus mt-4 block text-center font-semibold underline underline-offset-4 hover:text-xp">
            {t.howItIsBuilt}
          </a>
        </div>
      </article>

      <article class="mt-16 md:mt-24">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <div class="max-w-xl">
            <h3 class="text-[clamp(2.5rem,6vw,4.25rem)] font-extrabold tracking-[-0.035em]">Dados Prontos</h3>
            <p class="mt-4 text-lg text-ink-soft">{t.dadosProntosSummary(scrapers.length)}</p>
          </div>
          <div class="flex flex-wrap gap-3">
            <ExternalLink locale={locale} href="https://dados.allanmxr.com.br" class="rounded-xl bg-cta px-5 py-2.5 font-semibold text-on-cta hover:opacity-90">
              {t.viewShowcase}
            </ExternalLink>
            <ExternalLink locale={locale} href={profile.links.apify} class="rounded-xl border border-ink px-5 py-2.5 font-semibold hover:bg-surface">
              {t.apifyProfile}
            </ExternalLink>
            <a href={projectPath('dados-prontos')} class="text-link self-center">{t.technicalChallenges}</a>
          </div>
        </div>
        <div class="mt-10 grid gap-x-10 gap-y-10 md:grid-cols-3">
          {scraperGroups.map(([group, items]) => (
            <div>
              <h4 class="border-b-2 border-ink pb-3 font-display text-xl font-bold">{t.scraperGroups[group]}</h4>
              <ul class="divide-y divide-line">
                {items.map((scraper) => (
                  <li>
                    <ExternalLink
                      locale={locale}
                      href={scraper.slug ? `${profile.links.apify}/${scraper.slug}` : profile.links.apify}
                      class="group block py-3.5"
                    >
                      <span class="font-semibold decoration-accent decoration-2 underline-offset-4 group-hover:underline">{text(scraper.name)}</span>
                      <span class="block text-sm text-ink-soft">{text(scraper.detail)}</span>
                    </ExternalLink>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </article>

      {yieldCase && (
        <article class="mt-16 grid gap-6 rounded-[1.75rem] border border-line p-6 sm:p-8 md:mt-24 md:grid-cols-[1fr_auto] md:items-end md:gap-12">
          <div class="max-w-2xl">
            <p class="inline-flex rounded-md border border-line px-2.5 py-1 text-sm font-semibold text-ink-soft">{t.paused}</p>
            <h3 class="mt-4 text-3xl">{yieldCase.data.title}</h3>
            <p class="mt-3 text-lg text-ink-soft">{yieldCase.data.summary}</p>
            <p class="mt-4 text-sm text-ink-soft"><span class="sr-only">{t.technologies}</span>{yieldCase.data.stack.join(', ')}</p>
          </div>
          <a href={projectPath(yieldCase.id)} class="text-link">{t.howItWasBuilt}</a>
        </article>
      )}
    </div>
  </section>

  <section id="journey" class="border-t border-line">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-28">
      <h2 class="max-w-2xl text-[clamp(2rem,4.6vw,3.25rem)]">{t.journeyTitle}</h2>
      <ol class="mt-12 grid gap-x-10 gap-y-12 md:mt-16 md:grid-cols-3 md:gap-y-16">
        {journey.map((stage) => (
          <li class="border-t-2 border-ink pt-4">
            <p class="font-pixel text-xl leading-none text-accent">{stage.year}</p>
            <h3 class="mt-4 text-2xl">{text(stage.title)}</h3>
            <p class="mt-1 text-ink-soft">{text(stage.role)}</p>
            <p class="mt-3">{text(stage.text)}</p>
            {stage.slug && <a href={projectPath(stage.slug)} class="text-link mt-4 inline-block">{t.journeyLink(text(stage.title))}</a>}
          </li>
        ))}
        <li class="border-t-2 border-accent pt-4">
          <p class="font-pixel text-xl leading-none text-accent">2026</p>
          <h3 class="mt-4 text-2xl">{job.company}</h3>
          <p class="mt-1 text-ink-soft">{text(profile.role)}</p>
          <p class="mt-3">{t.journeyNowText}</p>
          <a href={projectPath(job.slug)} class="text-link mt-4 inline-block">{t.journeyNowLink}</a>
        </li>
      </ol>
      <p class="mt-14 flex items-center gap-3">
        <span class="size-3 shrink-0 bg-accent" aria-hidden="true" />
        <span>{t.youAreHere} <a href="#now" class="text-link">{t.youAreHereLink}</a></span>
      </p>
    </div>
  </section>

  <section id="stack" class="border-t border-line">
    <div class="mx-auto grid max-w-6xl gap-16 px-4 py-20 sm:px-6 md:grid-cols-[1fr_18rem] md:py-28">
      <div>
        <h2 class="text-[clamp(2rem,4.6vw,3.25rem)]">{t.stackTitle}</h2>
        <dl class="mt-10 border-b border-line">
          {skills.map((skill) => (
            <div class="grid gap-1 border-t border-line py-4 sm:grid-cols-[9rem_1fr] sm:gap-6">
              <dt class="font-display text-lg font-bold">{text(skill.area)}</dt>
              <dd class="text-ink-soft">{skill.items.map(text).join(', ')}</dd>
            </div>
          ))}
        </dl>
      </div>
      <aside class="space-y-12">
        <div>
          <h2 class="text-2xl">{t.educationTitle}</h2>
          <ul class="mt-5 space-y-4">
            {education.map((course) => (
              <li>
                <p class="font-semibold">{text(course.data.degree)}</p>
                <p class="text-sm text-ink-soft">{course.data.institution}, {t.period(course.data.start, course.data.end)}</p>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h2 class="text-2xl">{t.languagesTitle}</h2>
          <dl class="mt-5 border-b border-line">
            {languages.map((language) => (
              <div class="flex justify-between gap-4 border-t border-line py-2.5">
                <dt class="font-semibold">{text(language.name)}</dt>
                <dd class="text-ink-soft">{text(language.level)}</dd>
              </div>
            ))}
          </dl>
        </div>
      </aside>
    </div>
  </section>

  <section id="contact" class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="rounded-[1.75rem] border border-panel-line bg-panel px-6 py-14 text-on-panel sm:px-10 md:px-14 md:py-20">
      <h2 class="max-w-3xl text-[clamp(2.5rem,6.6vw,4.75rem)] leading-[0.98] font-extrabold tracking-[-0.035em]">{t.contactTitle}</h2>
      <p class="mt-6 max-w-xl text-lg text-on-panel-soft">{t.contactLead}</p>
      <a
        href={`mailto:${profile.email}`}
        class="on-panel-focus mt-9 inline-block max-w-full font-display text-[clamp(1.4rem,4.6vw,2.5rem)] font-bold break-all text-xp underline decoration-2 underline-offset-8 hover:decoration-4"
      >
        {profile.email}
      </a>
      <ul class="mt-12 flex flex-wrap gap-x-8 gap-y-3 font-semibold">
        <li><ExternalLink locale={locale} href={profile.links.linkedin} class="on-panel-focus underline underline-offset-4 hover:text-xp">LinkedIn</ExternalLink></li>
        <li><ExternalLink locale={locale} href={profile.links.github} class="on-panel-focus underline underline-offset-4 hover:text-xp">GitHub</ExternalLink></li>
        <li><ExternalLink locale={locale} href={profile.links.apify} class="on-panel-focus underline underline-offset-4 hover:text-xp">Apify</ExternalLink></li>
        <li class="font-normal text-on-panel-soft">{place}</li>
      </ul>
    </div>
  </section>
</Layout>

<script>
  const resumeMenu = document.querySelector<HTMLDetailsElement>('#resume-menu');
  document.addEventListener('click', (event) => {
    if (!resumeMenu?.open || !(event.target instanceof Element)) return;
    if (resumeMenu.contains(event.target) && !event.target.closest('a')) return;
    resumeMenu.open = false;
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !resumeMenu?.open) return;
    resumeMenu.open = false;
    resumeMenu.querySelector('summary')?.focus();
  });
</script>
