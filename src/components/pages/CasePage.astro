---
import { render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import StoryList from '../StoryList.astro';
import PagerNav from '../PagerNav.astro';
import ExternalLink from '../ExternalLink.astro';
import { projectPath, ui, type Locale } from '../../i18n/ui';

type Case = CollectionEntry<'cases' | 'casesEn'>;

interface Props {
  locale: Locale;
  entry: Case;
  previous: Case;
  next: Case;
  nextStoryCount: number;
  stories: CollectionEntry<'stories' | 'storiesEn'>[];
}

const { locale, entry, previous, next, nextStoryCount, stories } = Astro.props;
const t = ui[locale];
const { Content } = await render(entry);
const { title, role, period, summary, stack, links, cover, gallery, videos } = entry.data;
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.home, item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: title, item: new URL(projectPath(entry.id), Astro.site).href },
  ],
};
---

<Layout locale={locale} title={t.caseTitle(title)} description={summary} jsonLd={breadcrumbJsonLd}>
  <article class="mx-auto max-w-3xl px-4 pt-8 pb-16 sm:px-6 md:pt-14">
    <a href="/" class="text-link">{t.backHome}</a>

    <header class="mt-12 flex items-start justify-between gap-6">
      <div>
        <p class="font-pixel text-base leading-none text-accent">{period}</p>
        <h1 class="mt-4 text-[clamp(2.75rem,9vw,5rem)] leading-[0.98] font-extrabold tracking-[-0.035em]">{title}</h1>
        <p class="mt-3 text-lg text-ink-soft">{role}</p>
      </div>
      {cover && <Image src={cover} alt="" width={112} class="size-20 shrink-0 rounded-2xl object-contain md:size-28" />}
    </header>

    <p class="mt-10 text-xl leading-relaxed">{summary}</p>

    {links.length > 0 && (
      <ul class="mt-6 flex flex-wrap gap-3">
        {links.map((link) => (
          <li>
            <ExternalLink locale={locale} href={link.href} class="inline-block rounded-xl bg-cta px-5 py-2.5 font-semibold text-on-cta hover:opacity-90">
              {link.label}
            </ExternalLink>
          </li>
        ))}
      </ul>
    )}

    <p class="mt-6 border-y border-line py-4 text-ink-soft">
      <span class="sr-only">{t.technologies}</span>{stack.join(', ')}
    </p>

    {entry.data.draft && <p class="mt-6 rounded-lg bg-xp px-4 py-2 font-semibold text-on-xp">{t.draftNotice}</p>}

    <div class="case-body mt-12">
      <Content />
    </div>

    {stories.length > 0 && <StoryList locale={locale} stories={stories} />}

    {gallery.length > 0 && (
      <section class="mt-16">
        <h2 class="text-3xl">{t.galleryTitle}</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          {gallery.map((picture) => (
            <Image src={picture.src} alt={picture.alt} widths={[480, 760]} sizes="(min-width: 640px) 380px, 92vw" class="w-full rounded-xl border border-line" />
          ))}
        </div>
      </section>
    )}

    {videos.length > 0 && (
      <section class="mt-16">
        <h2 class="text-3xl">{t.videosTitle}</h2>
        <ul class="mt-6 grid gap-x-4 gap-y-6 sm:grid-cols-2">
          {videos.map((video) => (
            <li>
              <ExternalLink locale={locale} href={`https://www.youtube.com/watch?v=${video.id}`} class="group block">
                <img
                  src={`https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`}
                  alt=""
                  width="480"
                  height="360"
                  loading="lazy"
                  class="aspect-video w-full rounded-xl border border-line object-cover"
                />
                <span class="mt-2.5 block font-semibold decoration-accent decoration-2 underline-offset-4 group-hover:underline">{video.title}</span>
              </ExternalLink>
            </li>
          ))}
        </ul>
      </section>
    )}

    <PagerNav
      ariaLabel={t.otherProjects}
      previous={{ href: projectPath(previous.id), label: t.previousProject, title: previous.data.title, meta: previous.data.period }}
      next={{
        href: projectPath(next.id),
        label: t.nextProject,
        title: next.data.title,
        meta: next.data.period,
        summary: next.data.summary,
        footer: nextStoryCount > 0 ? `${next.data.role}, ${nextStoryCount} ${nextStoryCount === 1 ? t.caseCountOne : t.caseCountOther}` : next.data.role,
      }}
    />
  </article>
</Layout>
