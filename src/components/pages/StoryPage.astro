---
import { getEntry, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PagerNav from '../PagerNav.astro';
import { profile } from '../../data/profile';
import { projectPath, ui, type Locale } from '../../i18n/ui';

type Story = CollectionEntry<'stories' | 'storiesEn'>;

interface Props {
  locale: Locale;
  story: Story;
  position: number;
  total: number;
  previous: Story;
  next: Story;
}

const { locale, story, position, total, previous, next } = Astro.props;
const t = ui[locale];
const project = await getEntry(story.data.project);
const { Content } = await render(story);
const homeUrl = new URL('/', Astro.site).href;
const projectUrl = new URL(projectPath(project.id), Astro.site).href;
const storyUrl = new URL(projectPath(story.id), Astro.site).href;
const storyJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TechArticle',
      '@id': `${storyUrl}#article`,
      headline: story.data.title,
      description: story.data.summary,
      url: storyUrl,
      mainEntityOfPage: storyUrl,
      inLanguage: t.htmlLang,
      image: new URL('/og.png', Astro.site).href,
      keywords: story.data.tags,
      author: { '@type': 'Person', '@id': new URL('/#person', Astro.site).href, name: profile.name, url: new URL('/', Astro.site).href },
      isPartOf: { '@type': 'WebSite', '@id': new URL('/#website', Astro.site).href, name: profile.name, url: new URL('/', Astro.site).href },
      about: { '@type': 'CreativeWork', name: project.data.title, url: projectUrl },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: t.home, item: homeUrl },
        { '@type': 'ListItem', position: 2, name: project.data.title, item: projectUrl },
        { '@type': 'ListItem', position: 3, name: story.data.title, item: storyUrl },
      ],
    },
  ],
};
---

<Layout
  locale={locale}
  title={`${story.data.title} · ${project.data.title}`}
  description={story.data.summary}
  ogType="article"
  jsonLd={storyJsonLd}
>
  <article class="mx-auto max-w-3xl px-4 pt-8 pb-16 sm:px-6 md:pt-14">
    <a href={projectPath(project.id)} class="text-link">{t.backTo(project.data.title)}</a>

    <header class="mt-12">
      <p class="font-semibold text-accent">{project.data.title}</p>
      <h1 class="mt-3 text-[clamp(2.25rem,7vw,3.75rem)] leading-[1.02] font-extrabold tracking-[-0.03em]">{story.data.title}</h1>
      <p class="mt-6 text-xl leading-relaxed text-ink-soft">{story.data.summary}</p>
      {story.data.tags.length > 0 && <p class="mt-6 border-y border-line py-4 text-ink-soft">{story.data.tags.join(', ')}</p>}
      {story.data.draft && <p class="mt-6 rounded-lg bg-xp px-4 py-2 font-semibold text-on-xp">{t.draftNotice}</p>}
    </header>

    <div class="case-body mt-10">
      <Content />
    </div>

    {total > 1 && (
      <PagerNav
        ariaLabel={t.otherCases(project.data.title)}
        previous={{ href: projectPath(previous.id), label: t.previousCase, title: previous.data.title, meta: project.data.title }}
        next={{
          href: projectPath(next.id),
          label: t.nextCase,
          title: next.data.title,
          meta: `${position % total + 1}/${total}`,
          summary: next.data.summary,
          footer: next.data.tags.slice(0, 3).join(', '),
        }}
      />
    )}
  </article>
</Layout>
