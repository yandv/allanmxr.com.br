---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { languages, profile, skills } from '../../data/profile';
import { isVisible } from '../../data/visibility';
import { collectionsOf } from '../../i18n/content';
import { locales, localize, projectPath, ui, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const text = localize(locale);
const role = text(profile.role);
const place = t.location(profile.city, profile.region);

const monthYear = new Intl.DateTimeFormat(t.htmlLang, { month: 'long', year: 'numeric', timeZone: 'UTC' });
const formatMonth = (value: string) => monthYear.format(new Date(`${value}-01T00:00:00Z`));

const cases = await getCollection(collectionsOf[locale].cases, isVisible);
const positions = cases
  .flatMap((entry) => (Array.isArray(entry.data.resume) ? entry.data.resume : []))
  .toSorted((a, b) => a.order - b.order);
const projects = cases
  .flatMap((entry) =>
    entry.data.resume && !Array.isArray(entry.data.resume)
      ? [{ id: entry.id, title: entry.data.title, period: entry.data.period, ...entry.data.resume }]
      : [],
  )
  .toSorted((a, b) => a.order - b.order);
const education = (await getCollection('education')).toSorted((a, b) => a.data.order - b.data.order);

const contacts = [
  { href: `mailto:${profile.email}`, label: profile.email },
  ...[new URL('/', Astro.site).href, profile.links.github, profile.links.linkedin].map((href) => {
    const url = new URL(href);
    return { href: url.href, label: `${url.host.replace(/^www\./, '')}${url.pathname}`.replace(/\/$/, '') };
  }),
];

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.home, item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: t.navResume, item: new URL('/resume', Astro.site).href },
  ],
};
---

<Layout
  locale={locale}
  title={t.resumeTitle(profile.shortName)}
  description={t.resumeDescription(profile.name, role, place)}
  jsonLd={breadcrumbJsonLd}
>
  <div class="resume-shell mx-auto max-w-[56rem] px-4 pt-4 pb-16 sm:px-6 md:pt-8">
    <nav class="no-print mb-6 flex flex-wrap items-center gap-3" aria-label={t.resumeActions}>
      {locales.map((code) => (
        <a
          href={ui[code].resumePdf}
          download
          hreflang={ui[code].htmlLang}
          lang={ui[code].htmlLang}
          class:list={[
            'rounded-lg px-4 py-2 font-semibold',
            code === locale ? 'bg-cta text-on-cta hover:opacity-90' : 'border border-ink hover:bg-surface',
          ]}
        >
          {ui[code].downloadPdfIn}
        </a>
      ))}
      <a href="/" class="text-link sm:ml-auto">{t.viewFullSite}</a>
    </nav>

    <article class="paper">
      <header class="masthead">
        <h1>{profile.name}</h1>
        <p class="headline">{role}</p>
        <ul class="contacts">
          {contacts.map((contact) => (
            <li><a href={contact.href}>{contact.label}</a></li>
          ))}
          <li>{place}</li>
        </ul>
      </header>

      <section>
        <h2>{t.summaryTitle}</h2>
        <p>{text(profile.summary)}</p>
      </section>

      <section>
        <h2>{t.experienceTitle}</h2>
        <ul class="entries">
          {positions.map((position) => (
            <li class="entry">
              <div class="entry-row">
                <h3>
                  {position.company}
                  {position.sideProject && <span class="tag">{t.sideProject}</span>}
                </h3>
                <p class="when">{t.period(formatMonth(position.start), position.end && formatMonth(position.end))}</p>
              </div>
              <div class="entry-row entry-sub">
                <p>{position.title}</p>
                <p>{position.location}</p>
              </div>
              <ul class="bullets">
                {position.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2>{t.resumeEducationTitle}</h2>
        <ul class="entries">
          {education.map((course) => (
            <li class="entry">
              <div class="entry-row">
                <h3>{text(course.data.degree)}</h3>
                <p class="when">{t.period(course.data.start, course.data.end)}</p>
              </div>
              <div class="entry-row entry-sub">
                <p>{course.data.institution}</p>
                {course.data.location && <p>{text(course.data.location)}</p>}
              </div>
              {course.data.thesis && (
                <p class="detail">
                  <strong>{t.thesis}:</strong> <cite>{text(course.data.thesis.title)}</cite>. {text(course.data.thesis.topics)}
                </p>
              )}
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2>{t.resumeProjectsTitle}</h2>
        <ul class="entries">
          {projects.map((project) => (
            <li class="entry">
              <div class="entry-row">
                <h3><a href={new URL(projectPath(project.id), Astro.site).href}>{project.title}</a></h3>
                <p class="when">{project.period}</p>
              </div>
              <p class="detail">{project.summary}</p>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2>{t.skillsTitle}</h2>
        <ul class="skills">
          {skills.map((skill) => (
            <li><strong>{text(skill.area)}:</strong> {skill.items.map(text).join(', ')}</li>
          ))}
          <li>
            <strong>{t.languagesTitle}:</strong>{' '}
            {languages.map((language) => `${text(language.name)} (${text(language.level).toLocaleLowerCase(t.htmlLang)})`).join(', ')}
          </li>
        </ul>
      </section>
    </article>
  </div>
</Layout>

<style>
  .paper {
    --resume-blue: #003264;
    --resume-ink: #161616;
    --resume-soft: #3b3b3b;
    max-width: 210mm;
    margin-inline: auto;
    border-radius: 0.25rem;
    background: #fff;
    padding: clamp(1.25rem, 5vw, 3rem) clamp(1rem, 5vw, 3.25rem);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.12),
      0 16px 40px rgb(0 0 0 / 0.1);
    color: var(--resume-ink);
    font-size: 0.9375rem;
    line-height: 1.45;
  }
  .paper a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: #9fb2c6;
    text-underline-offset: 2px;
  }
  .paper a:hover {
    color: var(--resume-blue);
  }
  .paper ::selection {
    background: #cfe0f2;
    color: var(--resume-ink);
  }
  .masthead {
    text-align: center;
  }
  .masthead h1 {
    color: var(--resume-blue);
    font-size: clamp(1.6rem, 6.4vw, 2.35em);
    font-weight: 800;
    letter-spacing: 0.02em;
    line-height: 1.1;
    text-transform: uppercase;
  }
  .headline {
    margin-top: 0.3em;
    font-weight: 600;
  }
  .contacts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.1em 0.45em;
    margin-top: 0.35em;
    font-size: 0.85em;
  }
  .contacts li + li::before {
    content: '|' / '';
    margin-right: 0.45em;
    color: #8a8a8a;
  }
  @media screen and (max-width: 48rem) {
    .contacts {
      gap: 0.2em 1em;
    }
    .contacts li + li::before {
      content: none;
    }
  }
  @media screen {
    .contacts a {
      display: inline-block;
      padding-block: 0.25rem;
    }
  }
  @media screen and (max-width: 40rem) {
    .contacts {
      flex-direction: column;
    }
    .contacts li + li::before {
      content: none;
    }
  }
  .paper h2 {
    margin-top: 1.1em;
    margin-bottom: 0.45em;
    border-bottom: 1px solid var(--resume-blue);
    padding-bottom: 0.15em;
    color: var(--resume-blue);
    font-size: 1.15em;
    letter-spacing: 0;
    line-height: 1.2;
    break-after: avoid;
  }
  .entries {
    display: grid;
    gap: 0.7em;
  }
  .entry {
    break-inside: avoid;
  }
  .entry-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    column-gap: 1em;
  }
  .paper h3 {
    font-family: var(--font-sans);
    font-size: 1.04em;
    letter-spacing: 0;
    line-height: 1.3;
  }
  .tag {
    margin-left: 0.35em;
    color: var(--resume-soft);
    font-size: 0.85em;
    font-style: italic;
    font-weight: 400;
  }
  .when {
    font-size: 0.85em;
    font-weight: 700;
  }
  .entry-sub {
    color: var(--resume-soft);
    font-size: 0.875em;
    font-style: italic;
  }
  .entry-sub p {
    padding-inline-end: 0.2em;
  }
  .bullets {
    margin-top: 0.2em;
    padding-left: 1.15em;
    list-style: disc;
    font-size: 0.93em;
  }
  .bullets li + li {
    margin-top: 0.1em;
  }
  .detail {
    margin-top: 0.15em;
    font-size: 0.93em;
  }
  .detail cite {
    font-style: italic;
  }
  .skills {
    display: grid;
    gap: 0.15em;
    font-size: 0.93em;
  }

  @media print {
    @page {
      size: A4;
      margin: 11mm 13mm 12mm;
    }
    :global(html),
    :global(body) {
      background: #fff;
    }
    :global(body > header),
    :global(body > footer),
    :global(body > a),
    .no-print {
      display: none;
    }
    .resume-shell {
      max-width: none;
      padding: 0;
    }
    .paper {
      max-width: none;
      border-radius: 0;
      padding: 0;
      box-shadow: none;
      font-size: 9.6pt;
      line-height: 1.38;
    }
    .masthead h1 {
      font-size: 2.3em;
    }
    .paper a {
      text-decoration: none;
    }
  }
</style>
