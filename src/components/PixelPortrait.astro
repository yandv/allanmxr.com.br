---
import { Image } from 'astro:assets';
import portrait from '../assets/allan-image.png';
import { job, journey, profile } from '../data/profile';
import { localize, ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const text = localize(locale);
const levelStartXp = [0, 12, 40, 90, 170, 290, 450];

const levels = [
  ...journey.map((stage) => ({ year: stage.year, title: text(stage.title), role: text(stage.role) })),
  { year: t.today, title: text(profile.role), role: job.company },
];
const lastLevel = levels.length - 1;
---

<figure
  class="rounded-[1.75rem] border border-panel-line bg-panel p-3 text-on-panel sm:p-4"
  data-portrait
  data-level-label={t.level}
  data-max-xp-label={t.maxXp}
  data-level-up-label={t.levelUp}
  data-play-again-label={t.playAgain}
>
  <div class="relative aspect-square overflow-hidden rounded-2xl bg-[#0a2a1f]" data-frame>
    <Image
      src={portrait}
      alt={t.portraitAlt}
      widths={[480, 720, 960]}
      sizes="(min-width: 768px) 30rem, 100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute top-0 -left-[14%] w-[125%] max-w-none"
      data-photo
    />
    <canvas
      width="1024"
      height="1024"
      class="absolute inset-0 size-full cursor-crosshair touch-pan-y transition-opacity duration-700"
      aria-hidden="true"
      hidden
      data-canvas></canvas>
    <p
      class="absolute top-3 left-3 rounded-md bg-xp px-2 py-1.5 font-pixel text-xs leading-none text-on-xp"
      hidden
      data-level-badge
    >
    </p>
  </div>

  <figcaption class="px-1 pt-4 pb-1 sm:px-2">
    <div class="min-h-[4.75rem]" data-captions>
      {levels.map((level, index) => (
        <p hidden={index !== lastLevel} data-level data-start-xp={levelStartXp[index]}>
          <span class="block font-pixel text-xs leading-none text-xp">{level.year}</span>
          <strong class="mt-1.5 block font-display text-xl leading-tight font-bold">{level.title}</strong>
          <span class="block text-[0.95rem] text-on-panel-soft">{level.role}</span>
        </p>
      ))}
    </div>

    <div class="invisible" data-hud>
      <div class="mt-3 flex items-center gap-3">
        <div
          class="h-3 flex-1 bg-on-panel/15 [mask-image:repeating-linear-gradient(90deg,#000_0_12px,transparent_12px_14px)]"
          role="progressbar"
          aria-label={t.levelXp}
          aria-valuemin="0"
          aria-valuemax="100"
          data-bar-track
        >
          <div class="h-full w-0 bg-xp transition-[width] duration-150" data-bar></div>
        </div>
        <span class="w-[5.5rem] text-right font-pixel text-xs leading-none text-xp" data-xp-label></span>
      </div>
      <div class="mt-4 flex items-center justify-between gap-4">
        <p class="text-[0.95rem] leading-snug text-on-panel-soft" data-hint data-finished-text={t.portraitFinished}>
          {t.portraitHint}
        </p>
        <button
          type="button"
          class="on-panel-focus shrink-0 rounded-xl bg-xp px-4 py-2.5 font-semibold text-on-xp hover:opacity-90"
          data-action
        >
          {t.levelUp}
        </button>
      </div>
    </div>
  </figcaption>
</figure>

<script>
  interface Cell {
    x: number;
    y: number;
    depth: number;
    born: number;
  }

  const cropLeft = 0.112;
  const cropSize = 0.8;
  const baseGrid = 8;
  const pixelDepths = 3;
  const popDuration = 150;
  const splitCooldown = 170;
  const autoSplitDelay = 14;
  const gapColor = '#0a2a1f';

  const figure = document.querySelector<HTMLElement>('[data-portrait]');
  const frame = figure?.querySelector<HTMLElement>('[data-frame]');
  const photo = figure?.querySelector<HTMLImageElement>('[data-photo]');
  const canvas = figure?.querySelector<HTMLCanvasElement>('[data-canvas]');
  const badge = figure?.querySelector<HTMLElement>('[data-level-badge]');
  const hud = figure?.querySelector<HTMLElement>('[data-hud]');
  const barTrack = figure?.querySelector<HTMLElement>('[data-bar-track]');
  const bar = figure?.querySelector<HTMLElement>('[data-bar]');
  const xpLabel = figure?.querySelector<HTMLElement>('[data-xp-label]');
  const hint = figure?.querySelector<HTMLElement>('[data-hint]');
  const captionsRegion = figure?.querySelector<HTMLElement>('[data-captions]');
  const action = figure?.querySelector<HTMLButtonElement>('[data-action]');
  const context = canvas?.getContext('2d');
  const sampler = document.createElement('canvas').getContext('2d', { willReadFrequently: true });

  if (figure && frame && photo && canvas && badge && hud && barTrack && bar && xpLabel && hint && captionsRegion && action && context && sampler) {
    const captions = [...figure.querySelectorAll<HTMLElement>('[data-level]')];
    const levelStarts = captions.map((caption) => Number(caption.dataset.startXp));
    const lastLevel = captions.length - 1;
    const idleHint = hint.textContent;
    const finishedHint = hint.dataset.finishedText;
    const { levelLabel = '', maxXpLabel = '', levelUpLabel = '', playAgainLabel = '' } = figure.dataset;
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

    await photo.decode();
    const bitmap = await createImageBitmap(photo);
    const side = bitmap.width * cropSize;

    const palettes = Array.from({ length: pixelDepths }, (_, depth) => {
      const grid = baseGrid << depth;
      sampler.canvas.width = grid;
      sampler.canvas.height = grid;
      sampler.drawImage(bitmap, bitmap.width * cropLeft, 0, side, side, 0, 0, grid, grid);
      return sampler.getImageData(0, 0, grid, grid).data;
    });

    const cells = new Map<string, Cell>();
    let xp = 0;
    let level = 0;
    let frameRequest = 0;

    const cellKey = (depth: number, x: number, y: number) => `${depth}:${x}:${y}`;

    const draw = (now: number) => {
      frameRequest = 0;
      let animating = false;
      context.clearRect(0, 0, canvas.width, canvas.height);
      for (const cell of cells.values()) {
        const grid = baseGrid << cell.depth;
        const size = canvas.width / grid;
        const age = (now - cell.born) / popDuration;
        const popping = !reducedMotion && age < 1;
        const inner = (size - Math.max(2, size * 0.06)) * (popping ? 0.45 + age * 0.55 : 1);
        const inset = (size - inner) / 2;
        const pixel = (cell.y * grid + cell.x) * 4;
        const palette = palettes[cell.depth];
        context.fillStyle = gapColor;
        context.fillRect(cell.x * size, cell.y * size, size, size);
        context.fillStyle = `rgb(${palette[pixel]} ${palette[pixel + 1]} ${palette[pixel + 2]})`;
        context.fillRect(cell.x * size + inset, cell.y * size + inset, inner, inner);
        animating ||= popping;
      }
      if (animating) requestDraw();
    };

    const requestDraw = () => {
      frameRequest ||= requestAnimationFrame(draw);
    };

    const updateHud = () => {
      const finished = level === lastLevel;
      const start = levelStarts[level];
      const span = finished ? 1 : levelStarts[level + 1] - start;
      const progress = finished ? 100 : ((xp - start) / span) * 100;
      bar.style.width = `${progress}%`;
      xpLabel.textContent = finished ? maxXpLabel : `${xp - start}/${span} XP`;
      barTrack.setAttribute('aria-valuenow', String(Math.round(progress)));
      barTrack.setAttribute('aria-valuetext', `${levelLabel} ${level + 1}, ${xpLabel.textContent}`);
      badge.textContent = `${levelLabel} ${level + 1}`;
      hint.textContent = finished && finishedHint ? finishedHint : idleHint;
      action.textContent = finished ? playAgainLabel : levelUpLabel;
      captions.forEach((caption, index) => (caption.hidden = index !== level));
      canvas.classList.toggle('opacity-0', finished);
      canvas.classList.toggle('pointer-events-none', finished);
    };

    const celebrate = () => {
      if (reducedMotion) return;
      badge.animate([{ transform: 'scale(1.45)' }, { transform: 'scale(1)' }], { duration: 380, easing: 'ease-out' });
      captions[level].animate(
        [
          { transform: 'translateY(10px)', opacity: 0 },
          { transform: 'none', opacity: 1 },
        ],
        { duration: 280, easing: 'ease-out' },
      );
      frame.animate([{ boxShadow: '0 0 0 5px var(--xp)' }, { boxShadow: '0 0 0 0 transparent' }], {
        duration: 620,
        easing: 'ease-out',
      });
    };

    const split = (cell: Cell) => {
      const born = performance.now();
      const depth = cell.depth + 1;
      cells.delete(cellKey(cell.depth, cell.x, cell.y));
      if (depth < pixelDepths) {
        for (const [column, row] of [[0, 0], [1, 0], [0, 1], [1, 1]]) {
          const x = cell.x * 2 + column;
          const y = cell.y * 2 + row;
          cells.set(cellKey(depth, x, y), { x, y, depth, born });
        }
      }
      xp += 1;
      if (xp >= levelStarts[level + 1]) {
        level += 1;
        celebrate();
      }
      updateHud();
      requestDraw();
    };

    const splitShallowest = () => {
      const open = [...cells.values()];
      const shallowest = Math.min(...open.map((cell) => cell.depth));
      const pool = open.filter((cell) => cell.depth === shallowest);
      split(pool[Math.floor(Math.random() * pool.length)]);
    };

    const restart = () => {
      cells.clear();
      for (let y = 0; y < baseGrid; y++) {
        for (let x = 0; x < baseGrid; x++) cells.set(cellKey(0, x, y), { x, y, depth: 0, born: 0 });
      }
      xp = 0;
      level = 0;
      updateHud();
      requestDraw();
    };

    const paint = (event: PointerEvent) => {
      const bounds = canvas.getBoundingClientRect();
      const pointerX = (event.clientX - bounds.left) / bounds.width;
      const pointerY = (event.clientY - bounds.top) / bounds.height;
      for (let depth = 0; depth < pixelDepths; depth++) {
        const grid = baseGrid << depth;
        const cell = cells.get(cellKey(depth, Math.floor(pointerX * grid), Math.floor(pointerY * grid)));
        if (!cell) continue;
        if (performance.now() - cell.born > splitCooldown) split(cell);
        return;
      }
    };

    canvas.addEventListener('pointerdown', paint);
    canvas.addEventListener('pointermove', paint);

    action.addEventListener('click', () => {
      if (level === lastLevel) return restart();
      const target = levelStarts[level + 1];
      if (reducedMotion) {
        while (xp < target) splitShallowest();
        return;
      }
      const timer = setInterval(() => {
        if (xp < target) splitShallowest();
        else clearInterval(timer);
      }, autoSplitDelay);
    });

    restart();
    canvas.hidden = false;
    badge.hidden = false;
    hud.classList.remove('invisible');
    captionsRegion.setAttribute('aria-live', 'polite');
  }
</script>
