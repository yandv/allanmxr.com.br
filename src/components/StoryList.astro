---
import type { CollectionEntry } from 'astro:content';
import { projectPath, ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  stories: CollectionEntry<'stories' | 'storiesEn'>[];
}

const { locale, stories } = Astro.props;
const t = ui[locale];
const pageSize = 6;
---

<section
  class="mt-16"
  data-story-list
  data-page-size={pageSize}
  data-count-one={t.caseCountOne}
  data-count-other={t.caseCountOther}
  data-page-label={t.page}
>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <h2 class="text-3xl">{t.storiesTitle}</h2>
    <p class="text-ink-soft" data-story-count aria-live="polite">{stories.length} {stories.length === 1 ? t.caseCountOne : t.caseCountOther}</p>
  </div>

  <div class="mt-6" data-story-search-wrapper hidden>
    <label for="story-search" class="sr-only">{t.storiesSearchLabel}</label>
    <input
      id="story-search"
      type="search"
      placeholder={t.storiesSearchPlaceholder}
      autocomplete="off"
      class="w-full rounded-xl border border-ink-soft bg-surface px-4 py-3 placeholder:text-ink-soft focus-visible:border-accent"
      data-story-search
    />
  </div>

  <ol class="mt-6 border-t border-line">
    {stories.map((story) => (
      <li class="border-b border-line" data-story data-search-text={[story.data.title, story.data.summary, ...story.data.tags].join(' ')}>
        <a href={projectPath(story.id)} class="group block py-6">
          <span class="block font-display text-2xl font-bold tracking-[-0.02em] decoration-accent decoration-2 underline-offset-4 group-hover:underline">
            {story.data.title}
          </span>
          <span class="mt-2 block text-ink-soft">{story.data.summary}</span>
          {story.data.tags.length > 0 && <span class="mt-3 block text-sm text-accent">{story.data.tags.join(', ')}</span>}
        </a>
      </li>
    ))}
  </ol>

  <p class="mt-6 text-ink-soft" data-story-empty hidden>{t.storiesEmpty}</p>

  <nav class="mt-8 flex flex-wrap items-center gap-2" aria-label={t.storiesPages} hidden data-story-pages></nav>
</section>

<script>
  const normalize = (text: string) =>
    text
      .normalize('NFD')
      .replace(/\p{Diacritic}/gu, '')
      .toLowerCase();

  for (const section of document.querySelectorAll<HTMLElement>('[data-story-list]')) {
    const pageSize = Number(section.dataset.pageSize);
    const { countOne, countOther, pageLabel } = section.dataset;
    const items = [...section.querySelectorAll<HTMLElement>('[data-story]')];
    const searchWrapper = section.querySelector<HTMLElement>('[data-story-search-wrapper]');
    const search = section.querySelector<HTMLInputElement>('[data-story-search]');
    const count = section.querySelector<HTMLElement>('[data-story-count]');
    const empty = section.querySelector<HTMLElement>('[data-story-empty]');
    const pages = section.querySelector<HTMLElement>('[data-story-pages]');
    const searchIndex = new Map(items.map((item) => [item, normalize(item.dataset.searchText ?? '')]));

    let currentPage = 1;

    const render = () => {
      const terms = normalize(search?.value ?? '').split(/\s+/).filter(Boolean);
      const matches = items.filter((item) => terms.every((term) => searchIndex.get(item)?.includes(term)));
      const totalPages = Math.max(1, Math.ceil(matches.length / pageSize));
      currentPage = Math.min(currentPage, totalPages);
      const visible = new Set(matches.slice((currentPage - 1) * pageSize, currentPage * pageSize));

      for (const item of items) item.hidden = !visible.has(item);
      if (empty) empty.hidden = matches.length > 0;
      if (count) count.textContent = `${matches.length} ${matches.length === 1 ? countOne : countOther}`;

      if (!pages) return;
      pages.hidden = totalPages <= 1;
      pages.replaceChildren(
        ...Array.from({ length: totalPages > 1 ? totalPages : 0 }, (_, index) => {
          const page = index + 1;
          const button = document.createElement('button');
          button.type = 'button';
          button.textContent = String(page);
          button.className =
            page === currentPage
              ? 'size-10 rounded-lg bg-cta font-semibold text-on-cta'
              : 'size-10 rounded-lg border border-line font-semibold hover:bg-surface';
          button.setAttribute('aria-label', `${pageLabel} ${page}`);
          if (page === currentPage) button.setAttribute('aria-current', 'page');
          button.addEventListener('click', () => {
            currentPage = page;
            render();
            section.scrollIntoView({ block: 'start' });
            items.find((item) => !item.hidden)?.querySelector('a')?.focus({ preventScroll: true });
          });
          return button;
        }),
      );
    };

    if (searchWrapper && items.length > pageSize) searchWrapper.hidden = false;
    search?.addEventListener('input', () => {
      currentPage = 1;
      render();
    });
    render();
  }
</script>
